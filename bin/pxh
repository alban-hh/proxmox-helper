#!/usr/bin/env bash
set -Eeuo pipefail

PXH_REPO="${PXH_REPO:-https://raw.githubusercontent.com/alban-hh/proxmox-helper/main}"
PXH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<USAGE
Usage: pxh <command> [args]

Commands:
  list                 Show available addons
  run <addon> [flags]  Run an addon (flags: --install, --update, --uninstall)
  help                 Show this help
USAGE
}

list_addons() {
  local file
  for file in "$PXH_ROOT"/addons/*.sh; do
    basename "$file" .sh
  done
}

run_addon_script() {
  local name="$1"
  shift
  local script="$PXH_ROOT/addons/${name}.sh"
  if [[ ! -f "$script" ]]; then
    echo "Unknown addon: ${name}" >&2
    echo "Run 'pxh list' to see what is available." >&2
    exit 64
  fi
  exec bash "$script" "$@"
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
  list) list_addons ;;
  run) run_addon_script "$@" ;;
  help | -h | --help) usage ;;
  *)
    usage
    exit 64
    ;;
  esac
}

main "$@"
