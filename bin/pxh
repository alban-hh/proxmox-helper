#!/usr/bin/env bash
set -Eeuo pipefail

PXH_REPO="${PXH_REPO:-https://raw.githubusercontent.com/alban-hh/proxmox-helper/main}"
PXH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<USAGE
Usage: pxh <command> [args]

Commands:
  list                 Show available addons
  run <addon> [flags]  Run an addon (flags: --install, --update, --uninstall, --yes, --verbose)
  update <addon>       Update an installed addon
  update-all           Update every addon that left an update script behind
  doctor               Show what the scripts would detect on this machine
  version              Print the proxmox-helper version
  help                 Show this help
USAGE
}

print_version() {
  cat "$PXH_ROOT/VERSION"
}

doctor() {
  local os="unknown" init="unknown"
  [[ -f /etc/os-release ]] && os="$(. /etc/os-release && echo "${PRETTY_NAME:-$ID}")"
  [[ -f /etc/alpine-release ]] && init="openrc"
  command -v systemctl &>/dev/null && init="systemd"
  echo "proxmox-helper $(print_version)"
  echo "os:        ${os}"
  echo "arch:      $(uname -m)"
  echo "init:      ${init}"
  echo "root:      $([[ "$(id -u)" -eq 0 ]] && echo yes || echo no)"
  echo "pve host:  $(command -v pveversion &>/dev/null && echo yes || echo no)"
  echo "docker:    $(command -v docker &>/dev/null && docker --version | cut -d' ' -f3 | tr -d ',' || echo missing)"
  echo "compose:   $(docker compose version --short 2>/dev/null || echo missing)"
  echo "curl:      $(command -v curl &>/dev/null && echo yes || echo missing)"
  echo "jq:        $(command -v jq &>/dev/null && echo yes || echo missing)"
  echo "updates:   $(find /usr/local/bin -maxdepth 1 -name 'update_*' 2>/dev/null | wc -l | tr -d ' ') update script(s)"
}

update_all() {
  local script found=0
  for script in /usr/local/bin/update_*; do
    [[ -x "$script" ]] || continue
    found=1
    echo "==> ${script##*/}"
    "$script" --yes || echo "!! ${script##*/} failed" >&2
  done
  ((found)) || echo "No update scripts found in /usr/local/bin."
}

list_addons() {
  local file
  for file in "$PXH_ROOT"/addons/*.sh; do
    basename "$file" .sh
  done
}

run_addon_script() {
  local name="$1"
  shift
  local script="$PXH_ROOT/addons/${name}.sh"
  if [[ ! -f "$script" ]]; then
    echo "Unknown addon: ${name}" >&2
    echo "Run 'pxh list' to see what is available." >&2
    exit 64
  fi
  exec bash "$script" "$@"
}

main() {
  local command="${1:-help}"
  shift || true
  case "$command" in
  list) list_addons ;;
  run) run_addon_script "$@" ;;
  update) run_addon_script "$1" --update ;;
  update-all) update_all ;;
  doctor) doctor ;;
  version) print_version ;;
  help | -h | --help) usage ;;
  *)
    usage
    exit 64
    ;;
  esac
}

main "$@"
